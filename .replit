modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]

[userenv.shared]
CLOUDFLARE_R2_BUCKET = "blasterbucket"
ADMIN_EMAILS = "blasterrclips@gmail.com"
ADMIN_APP_URL = "https://goblasterr.com/blasterr-admin"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18115
externalPort = 3001

[[ports]]
localPort = 23451
externalPort = 3000

[[ports]]
localPort = 25844
externalPort = 80
